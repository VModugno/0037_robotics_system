\newlabel{fig:mobile_arena}{{1}{3}{The \texttt {MobilePickPlaceEnv} dual-table pharmacy bay (\texttt {cw2\_starter/mobile\_pick\_place\_env.py}): (a)~Robosuite/MuJoCo \texttt {agentview} render of \texttt {PandaOmron} in the service aisle facing Table~A (pickup bench with red specimen cube) and Table~B (drop-off bench with green target pad); (b)~top-down metric layout showing Station~A ($x=-0.56,\,y=-0.55\,$m), Station~B ($x=-0.56,\,y=+0.55\,$m), the 4-stage transfer sequence, and the base-to-table safety boundary ($x_{\max } = -0.44\,$m)}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Coupled Whole-Body Control Barrier Function (CBF) constraints enforced by \texttt  {WholeBodyCBFShield} (Question~4): (a)~top-down mobile-base barrier $h_x = x_{\max } - x_{\mathrm  {base}} \ge 0$ ($x_{\max } = -0.44\,$m) preventing base collisions with Table~A and Table~B; (b)~side-view end-effector tabletop barrier $h_z = z_{\mathrm  {ee}} - z_{\min } \ge 0$ ($z_{\min } = 0.815\,$m) blocking downward slams into the benches.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:wholebody_cbf}{{2}{6}{Coupled Whole-Body Control Barrier Function (CBF) constraints enforced by \texttt {WholeBodyCBFShield} (Question~4): (a)~top-down mobile-base barrier $h_x = x_{\max } - x_{\mathrm {base}} \ge 0$ ($x_{\max } = -0.44\,$m) preventing base collisions with Table~A and Table~B; (b)~side-view end-effector tabletop barrier $h_z = z_{\mathrm {ee}} - z_{\min } \ge 0$ ($z_{\min } = 0.815\,$m) blocking downward slams into the benches}{figure.2}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Overview of the $8\times 12$ hospital ward floor (\texttt  {HospitalWardEnv}, defined in \texttt  {cw1\_starter/q2\_hospital\_ward.py}). MedBot starts at the pharmacy (\texttt  {S}) and must deliver medication to the ward station (\texttt  {G}, $+10.0$). Passing through the sterile ICU (\texttt  {I}) incurs a $-5.0$ disruption penalty; automatic doors (\texttt  {D}) incur $-0.5$; stepping into the biohazard spill (\texttt  {B}) incurs $-50.0$ and triggers an immediate decontamination reset to \texttt  {S}.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:hospital_ward}{{1}{3}{Overview of the $8\times 12$ hospital ward floor (\texttt {HospitalWardEnv}, defined in \texttt {cw1\_starter/q2\_hospital\_ward.py}). MedBot starts at the pharmacy (\texttt {S}) and must deliver medication to the ward station (\texttt {G}, $+10.0$). Passing through the sterile ICU (\texttt {I}) incurs a $-5.0$ disruption penalty; automatic doors (\texttt {D}) incur $-0.5$; stepping into the biohazard spill (\texttt {B}) incurs $-50.0$ and triggers an immediate decontamination reset to \texttt {S}}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Stochastic wheel-slip transition model for MedBot in \texttt  {HospitalWardEnv}. The black square denotes the current cell, the red arrow and dark-grey square denote the intended motion (probability $1 - p_{\mathrm  {slip}}$), and the light-grey squares denote perpendicular slip outcomes (probability $p_{\mathrm  {slip}}/2$ each).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:slip_model}{{2}{5}{Stochastic wheel-slip transition model for MedBot in \texttt {HospitalWardEnv}. The black square denotes the current cell, the red arrow and dark-grey square denote the intended motion (probability $1 - p_{\mathrm {slip}}$), and the light-grey squares denote perpendicular slip outcomes (probability $p_{\mathrm {slip}}/2$ each)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Part~2 MedBot subsystems: (a)~\texttt  {SterileArmEnv} (\texttt  {q3\_sterile\_arm.py}), a 2-DoF planar sample-transfer arm operating inside a biosafety cabinet with hard joint limits and an internal circular centrifuge keep-out zone ($r = 0.16\,$m); (b)~mechanical schematic of \texttt  {medbot\_payload\_trolley} (\texttt  {q4\_payload\_sim.py}), showing the wheeled chassis ($2.5\,$kg), slide actuator $u$, hinged specimen mast ($\theta $), and the three randomized physical parameters ($m_p$, $d$, $f$).}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:sterile_arm_trolley}{{3}{6}{Part~2 MedBot subsystems: (a)~\texttt {SterileArmEnv} (\texttt {q3\_sterile\_arm.py}), a 2-DoF planar sample-transfer arm operating inside a biosafety cabinet with hard joint limits and an internal circular centrifuge keep-out zone ($r = 0.16\,$m); (b)~mechanical schematic of \texttt {medbot\_payload\_trolley} (\texttt {q4\_payload\_sim.py}), showing the wheeled chassis ($2.5\,$kg), slide actuator $u$, hinged specimen mast ($\theta $), and the three randomized physical parameters ($m_p$, $d$, $f$)}{figure.3}{}}
